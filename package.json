{
  "name": "reelup",
  "version": "1.0.0",
  "description": "A desktop uploader for Immich, SFTP, Nextcloud, Dropbox, and local-folder destinations",
  "main": "src/main.js",
  "author": "Obi",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "lint": "eslint .",
    "icons": "node scripts/generate-icons.js",
    "build": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.reelup.app",
    "productName": "ReelUp",
    "icon": "assets/icon.png",
    "directories": {
      "output": "dist"
    },
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.7.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.7.0",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0",
    "sharp": "^0.35.3",
    "ssh2-sftp-client": "^10.0.3"
  }
}
